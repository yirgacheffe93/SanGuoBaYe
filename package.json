{
  "name": "sanguobaye-desktop",
  "productName": "三国霸业",
  "version": "0.1.0",
  "description": "三国霸业 桌面版（macOS）—— 基于 baye-alpha 引擎的离线单机版本",
  "main": "electron/main.js",
  "author": "yirgacheffe",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "smoke": "BAYE_SMOKE=1 electron .",
    "pack": "bash tools/pack-macos.sh",
    "dist": "bash tools/pack-macos.sh dmg",
    "icon": "python3 tools/make_icon.py && bash tools/make-icns.sh"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.yirgacheffe.sanguobaye",
    "productName": "三国霸业",
    "copyright": "基于 baye-alpha 引擎",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "electronDist": "node_modules/electron/dist",
    "asar": true,
    "files": [
      "electron/**/*",
      "shell/**/*",
      "desktop.html",
      "js/baye.js",
      "js/baye.wasm",
      "js/bridge.js",
      "js/lcd.js",
      "js/jquery.min.js",
      "js/encoding-indexes.js",
      "js/encoding.js",
      "js/sprintf.js",
      "libs/**/*",
      "libs.json",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.games",
      "icon": "build/icon.icns",
      "identity": null,
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "darkModeSupport": true,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ]
    },
    "dmg": {
      "title": "三国霸业",
      "iconSize": 110,
      "contents": [
        {
          "x": 180,
          "y": 190
        },
        {
          "x": 480,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "afterPack": "tools/after-pack.js"
  }
}
